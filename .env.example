# AbiOS – Konfiguration. Kopieren nach .env und anpassen.

# --- Anmeldung -------------------------------------------------------------
# Passwort für die Anmeldung. Leer = keine Anmeldung (nur für lokale Nutzung!).
APP_PASSWORD=
# true, sobald AbiOS über HTTPS läuft (z. B. hinter Caddy)
COOKIE_SECURE=false

# --- Daten ----------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=50

# --- KI-Anbieter ----------------------------------------------------------
# Eine der Vorlagen unten aktivieren (Kommentarzeichen entfernen).
# Modellnamen ändern sich – aktuelle Namen auf der Seite des Anbieters prüfen.
AI_PROVIDER=none

# Option A (empfohlen, kostenlos): Google Gemini, Free Tier.
# Schlüssel: https://aistudio.google.com/apikey
# Hinweis: Im kostenlosen Tarif darf Google Anfragen zur Verbesserung seiner
# Dienste verwenden. Nichts Persönliches in Notizen schreiben, das nicht raus soll.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=dein-schluessel
# AI_MODEL_FAST=gemini-3.8-flash
# AI_MODEL_STRONG=gemini-3.8-flash
# Bei Überlastung (häufig im Free Tier) automatisch ausweichen:
# AI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-flash-lite-latest

# Option B (kostenlos, komplett lokal, braucht starken Rechner): Ollama
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL_FAST=qwen3:8b
# AI_MODEL_STRONG=qwen3:14b

# Option C: Mistral (EU), OpenAI, Groq, OpenRouter – alle OpenAI-kompatibel:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_API_KEY=...
# AI_MODEL_FAST=mistral-small-latest
# AI_MODEL_STRONG=mistral-medium-latest

# Option D: Claude (Anthropic), kostenpflichtig
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL_FAST=claude-haiku-4-5
# AI_MODEL_STRONG=claude-opus-5-5

# Testmodus ohne echte KI (Platzhalter-Aufgaben):
# AI_PROVIDER=mock
# AI_MODEL_FAST=mock

# json_object (Standard, breit kompatibel) oder json_schema (strenger)
AI_JSON_MODE=json_object
